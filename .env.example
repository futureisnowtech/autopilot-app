# Copy to .env.local for development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# --- Core (already configured) ---
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# --- Stripe (required to go live with billing) ---
# Live secret key from the Stripe dashboard. Checkout/webhook routes fall
# back to a mock key and log a warning without this — billing is a no-op
# until it's set.
STRIPE_SECRET_KEY=
# From Stripe dashboard → Developers → Webhooks → your endpoint → Signing
# secret. Required in production: the webhook route refuses to process
# events without it rather than trusting an unsigned payload.
STRIPE_WEBHOOK_SECRET=

# --- Error monitoring (Sentry, optional but recommended before ad traffic) ---
# Create a free project at sentry.io, use its Next.js project's DSN for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Ad conversion tracking (optional, wire up before spending ad budget) ---
# GA4 Measurement ID (G-XXXXXXX) and/or a standalone Google Ads conversion
# ID (AW-XXXXXXX) — either or both can be set, both load via the same tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Meta Ads Manager → Events Manager → your Pixel → Pixel ID.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Mobile shell (Capacitor, optional — only needed for iOS/Android builds) ---
CAPACITOR_SERVER_URL=
